{
  "name": "@mnc/desktop",
  "version": "0.1.0",
  "description": "M&C Workbench Desktop Application",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri:dev": "tauri dev",
    "build": "tsc && vite build",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@mnc/contracts": "workspace:*",
    "@mnc/command-system": "workspace:*",
    "@mnc/ui-kit": "workspace:*",
    "@tanstack/react-virtual": "^3.1.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.51.0",
    "zod": "^3.22.4",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.2",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "happy-dom": "^14.3.10",
    "typescript": "^5.4.2",
    "user-event": "^14.5.2",
    "vite": "^5.1.6",
    "vitest": "^1.3.1"
  }
